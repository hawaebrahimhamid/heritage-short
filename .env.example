# ==============================================================================
# Heritage-Short Environment Configuration Template (.env.example)
# Copy this file to .env and insert your real credentials. NEVER commit .env to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Core APIs
# ------------------------------------------------------------------------------
# Google Gemini API: used for storyboard compiling, scene prompts & QA checks
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare: used for Workers AI inference and R2 media storage / CDN hosting
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# ------------------------------------------------------------------------------
# 2. Amharic TTS Configuration (Optional / Provider-specific)
# ------------------------------------------------------------------------------
# Provider choice: local (e.g. Coqui TTS), elevenlabs, or custom service
AMHARIC_TTS_PROVIDER=local
AMHARIC_TTS_API_KEY=
AMHARIC_TTS_VOICE_ID=amharic_elder_female_mariam
AMHARIC_TTS_ENDPOINT=https://api.example.com/v1/audio/speech

# ------------------------------------------------------------------------------
# 3. Model & Compute Configuration (Optional)
# ------------------------------------------------------------------------------
# Kaggle API credentials (for remote GPU batch rendering / model hosting)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Default models for video, audio, and prompt compilation
GEMINI_MODEL=gemini-2.5-flash
VIDEO_MODEL=cinematic-v2-anchor
AUDIO_MODEL=amharic-elder-tts-v3

# ------------------------------------------------------------------------------
# 4. Pipeline Paths & Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
OUTPUT_DIR=./outputs
RUNS_LOG_PATH=./runs.jsonl
